NODE_ENV=production
PORT=3000
APP_BIND_HOST=127.0.0.1
APP_ORIGIN=https://portal.example.org
DATA_DIR=./data
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Generate with: openssl rand -base64 32
APP_KEY_BASE64=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
ADMIN_ID=MBC-ADMIN
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

BUILD_DEADLINE_AT=2026-09-02T09:00:00+07:00
PORTAL_OPEN_AT=2026-09-02T11:00:00+07:00
SUBMISSION_DEADLINE_AT=2026-09-04T15:00:00+07:00
GAME_LOCK_AT=2026-09-04T18:00:00+07:00

WG_CIDR=10.77.4.0/24
TAILSCALE_CIDR=100.64.0.0/10
WG_HUB_IP=10.77.4.1
WG_ATTACKER_START=10.77.4.10
WG_ATTACKER_END=10.77.4.39
WG_TARGET_START=10.77.4.100
WG_TARGET_END=10.77.4.129
WG_ENDPOINT=portal.example.org:51820
WG_SERVER_PUBLIC_KEY=REPLACE_WITH_WIREGUARD_SERVER_PUBLIC_KEY
WG_VERIFY_URL=https://portal.example.org/internal/verify
WG_INTERFACE=mbc-las-w4
WG_HELPER_PATH=/usr/local/sbin/mbc-las-wg-peer
WG_SUDO_PATH=/usr/bin/sudo
WG_HEALTH_HANDSHAKE_MAX_AGE_SECONDS=180
WG_HEALTH_PROBE_INTERVAL_SECONDS=20
WG_HEALTH_REQUIRED_FAILURES=3

# These must remain false in production.
WG_HELPER_DRY_RUN=false
SKIP_NETWORK_CHECKS=false
